{
  "name": "@ui-components/vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    }
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "test": "vitest run",
    "test:browser": "pnpm build && pnpm build:consumer && pnpm build-storybook && playwright test",
    "build:consumer": "vite build --config vite.consumer.config.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.0",
    "echarts": "^6.1.0"
  },
  "dependencies": {
    "@tanstack/vue-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/vue3-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.5.1",
    "echarts": "6.1.0",
    "jsdom": "31.0.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  }
}
